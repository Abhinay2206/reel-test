{
  "name": "contextbridge-reel",
  "version": "1.0.0",
  "private": true,
  "description": "ContextBridge promo reel (16:9 and 9:16), built with Remotion in the contextbridge.orvantia.in design system",
  "scripts": {
    "studio": "remotion studio",
    "score": "python3 scripts/build_score.py",
    "render:16x9": "remotion render Promo16x9 out/ContextBridge-Promo-16x9.mp4",
    "render:9x16": "remotion render Promo9x16 out/ContextBridge-Promo-9x16.mp4",
    "render": "npm run render:16x9 && npm run render:9x16",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/noise": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
